# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
WEB_ORIGIN=http://localhost:3001

# MySQL (docker-compose defaults)
DATABASE_URL=mysql://lawassist:lawassist@localhost:3306/lawassist
# Worker scraper connection (app_scraper in deployed envs). Empty = DATABASE_URL.
SCRAPER_DATABASE_URL=

# Redis / Qdrant / TEI
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_COLLECTION=section_chunks

# S3 (SeaweedFS in docker-compose locally; it accepts any credentials, so these are placeholders)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=lawassist-dev
S3_ACCESS_KEY_ID=local-dev
S3_SECRET_ACCESS_KEY=local-dev

# AI provider (Anthropic via @ai-sdk/anthropic). Leave ANTHROPIC_BASE_URL empty to call Anthropic directly.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL_ASSISTANT=claude-opus-5-5
LLM_MODEL_EXTRACTION=claude-opus-5-5

# Auth (ES256 PEM keys, \n-escaped). Local: `pnpm --filter @lawassist/api keys >> .env`.
# Unset in development = throwaway keys (sessions end when the API restarts). Required in staging/production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# HMAC key for one-time codes (>= 32 chars). Required in staging/production.
OTP_HMAC_KEY=
# console = print codes to the API's stdout. Development only; refused in staging/production (real sender: PRE-05).
OTP_DELIVERY=console
