# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
WEB_ORIGIN=http://localhost:3001

# MySQL (docker-compose defaults)
DATABASE_URL=mysql://lawassist:lawassist@localhost:3306/lawassist
# Worker scraper connection (app_scraper in deployed envs). Empty = DATABASE_URL.
SCRAPER_DATABASE_URL=

# Redis / Qdrant / TEI
REDIS_URL=redis://localhost:6379
# Worker: weekly SCOB case-law crawl. Keep false until the Supreme Court site terms are checked (PRE-11).
SCOB_CRAWL_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_COLLECTION=section_chunks

# S3 (SeaweedFS in docker-compose locally; it accepts any credentials, so these are placeholders)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=lawassist-dev
S3_ACCESS_KEY_ID=local-dev
S3_SECRET_ACCESS_KEY=local-dev
# Server-side encryption presigned uploads must use. Empty locally; aws:kms in staging/production (required there).
S3_SSE=

# AI provider (Anthropic via @ai-sdk/anthropic). Leave ANTHROPIC_BASE_URL empty to call Anthropic directly.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL_ASSISTANT=claude-opus-5-5
LLM_MODEL_EXTRACTION=claude-opus-5-5

# Push notifications (FCM). Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the key file outside the repo (or in secrets/, which git ignores). The key file is a secret: never commit it. Set one of the two; empty = push off.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# Auth (ES256 PEM keys, \n-escaped). Local: `pnpm --filter @lawassist/api keys >> .env`.
# Unset in development = throwaway keys (sessions end when the API restarts). Required in staging/production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# HMAC key for one-time codes (>= 32 chars). Required in staging/production.
OTP_HMAC_KEY=
# console = print codes to the API's stdout. Development only; refused in staging/production (real sender: PRE-05).
OTP_DELIVERY=console
# smtp = email codes over SMTP (SMS codes are still printed in development; SMS gateway: PRE-05).
# Gmail: Google Account > Security > 2-Step Verification > App passwords; '@' in the user becomes %40:
#   SMTP_URL=smtps://you%40gmail.com:<16-char-app-password>@smtp.gmail.com:465
SMTP_URL=
OTP_EMAIL_FROM=

# Web (Next.js): API origin the browser calls. The API allows this web origin via WEB_ORIGIN.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Server-side rendering (law library) may reach the API on a private address; defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
