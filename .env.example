# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
WEB_ORIGIN=http://localhost:3001

# MySQL (docker-compose defaults)
DATABASE_URL=mysql://lawassist:lawassist@localhost:3306/lawassist
# Worker scraper connection (app_scraper in deployed envs). Empty = DATABASE_URL.
SCRAPER_DATABASE_URL=

# Redis / Qdrant / TEI
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_COLLECTION=section_chunks

# S3 (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=lawassist-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# AI provider (Anthropic via @ai-sdk/anthropic). Leave ANTHROPIC_BASE_URL empty to call Anthropic directly.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL_ASSISTANT=claude-opus-5-5
LLM_MODEL_EXTRACTION=claude-opus-5-5

# Auth (ES256 PEM keys, \n-escaped)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
